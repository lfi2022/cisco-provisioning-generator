[Unit]
Description=LFINFO Cisco Provisioning Generator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/lfinfo-provisioning
EnvironmentFile=-/opt/lfinfo-provisioning/.env
ExecStart=/opt/lfinfo-provisioning/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
